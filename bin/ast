#!/bin/bash
# ast — Claude Session Tracker CLI
#   ast list              show tracked sessions
#   ast jump <session-id> focus the terminal session (cmux / iTerm2 / tmux / Terminal.app)
#   ast clean [hours]     drop ended sessions and sessions idle > N hours (default 24)
set -euo pipefail

# SwiftBar/launchd run with a minimal PATH — make sure claude & friends resolve
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Swift's Process hands arguments over in NFD (decomposed jamo) — grep can
# never match NFC transcripts then. Renormalize non-ASCII args to NFC.
if command -v python3 >/dev/null 2>&1; then
  _nfc_args=()
  _nfc_changed=0
  for _a in "$@"; do
    case "$_a" in
      (*[![:ascii:]]*)
        _nfc_args+=("$(printf '%s' "$_a" | python3 -c 'import sys,unicodedata;sys.stdout.write(unicodedata.normalize("NFC",sys.stdin.read()))' 2>/dev/null || printf '%s' "$_a")")
        _nfc_changed=1 ;;
      (*) _nfc_args+=("$_a") ;;
    esac
  done
  [ "$_nfc_changed" = "1" ] && set -- "${_nfc_args[@]}"
fi

STATE_DIR="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/sessions"
GROUPS_FILE="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/groups.json"
NAMES_FILE="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/names.json"
AGENTS_CACHE="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/agents-cache.json"
# full `claude agents --json --all` result, reused for 10s — the CLI is a
# ~300ms Node boot and event-driven refreshes can arrive in bursts
AGENTS_ALL_CACHE="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/agents-all-cache.json"
# memoised sessions-json output: recomputing costs ~200ms, and between
# events nothing it reads has changed
SJ_CACHE="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/sessions-cache.json"
SJ_KEY="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/sessions-cache.key"
SJ_PIDS="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/sessions-cache.pids"
# extra paths whose mtime changes the result (codex rollouts drive the stale-
# turn decay) — recorded by the last run so the signature can stat them
SJ_WATCH="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/sessions-cache.watch"
PINS_FILE="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/pins.json"
SORDER_FILE="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/session-order.json"
COLORS_FILE="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/colors.json"
GORDER_FILE="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/group-order.json"

# The menubar app refreshes sessions-json every 5s, which keeps this cache
# warm — jumps then skip the ~0.6s claude CLI startup entirely.
fetch_agents() {
  if [ -f "$AGENTS_CACHE" ]; then
    local age=$(( $(date +%s) - $(stat -f %m "$AGENTS_CACHE" 2>/dev/null || echo 0) ))
    if [ "$age" -lt 10 ]; then cat "$AGENTS_CACHE"; return 0; fi
  fi
  local out
  out=$(claude agents --json 2>/dev/null || echo '[]')
  printf '%s' "$out" >"$AGENTS_CACHE.tmp" 2>/dev/null && mv "$AGENTS_CACHE.tmp" "$AGENTS_CACHE" 2>/dev/null
  printf '%s' "$out"
}
mkdir -p "$STATE_DIR"

# byte-clean shell quoting — /bin/bash 3.2's printf %q mangles multibyte
# UTF-8 (mixed raw/octal output), which broke AppleScript argv (-1700)
shquote() {
  local s="$1"
  s="${s//\'/\'\\\'\'}"
  printf "'%s'" "$s"
}

status_icon() {
  case "$1" in
    running) echo "🟢" ;;
    waiting) echo "🟡" ;;
    done)    echo "⚪" ;;
    ended)   echo "✖️ " ;;
    *)       echo "❔" ;;
  esac
}

cmd_list() {
  local found=0
  printf "%-3s %-10s %-36s %-28s %s\n" "" "STATUS" "SESSION" "CWD" "AGE"
  for f in "$STATE_DIR"/*.json; do
    [ -e "$f" ] || continue
    found=1
    local s
    s=$(jq -r '[.status, .session_id, (.cwd // "?"), .updated_at] | @tsv' "$f")
    IFS=$'\t' read -r status sid cwd updated <<<"$s"
    local age=$(( $(date +%s) - updated ))
    local age_h="$((age / 60))m"
    [ "$age" -ge 3600 ] && age_h="$((age / 3600))h"
    printf "%-3s %-10s %-36s %-28s %s\n" \
      "$(status_icon "$status")" "$status" "$sid" "${cwd/#$HOME/~}" "$age_h"
  done
  [ "$found" -eq 1 ] || echo "(no tracked sessions — hooks installed?)"
}

jump_cmux() { # $1=workspace uuid
  local bin
  bin=$(command -v cmux 2>/dev/null || true)
  [ -n "$bin" ] || bin="/Applications/cmux.app/Contents/Resources/bin/cmux"
  [ -x "$bin" ] || return 1
  # workspace focus needs cmux Settings → Automation enabled for external
  # processes; if denied we still bring the app forward
  "$bin" workspace-action --action focus --workspace "$1" >/dev/null 2>&1 ||
    "$bin" rpc workspace.focus "{\"workspace_id\":\"$1\"}" >/dev/null 2>&1 || true
  open -a cmux 2>/dev/null || return 1
}

jump_iterm() { # $1=ITERM_SESSION_ID (w0t2p0:UUID)
  local uuid="${1##*:}"
  osascript - "$uuid" <<'APPLESCRIPT'
on run argv
  set target to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if id of s is target then
            select s
            select t
            select w
            activate
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  error "session not found"
end run
APPLESCRIPT
}

jump_tmux() { # $1=TMUX_PANE, $2=term_program
  command -v tmux >/dev/null || return 1
  tmux switch-client -t "$1" 2>/dev/null || tmux select-pane -t "$1" 2>/dev/null || return 1
  # bring the terminal hosting the tmux client to front
  case "${2:-}" in
    iTerm.app) open -a iTerm 2>/dev/null || true ;;
    Apple_Terminal) open -a Terminal 2>/dev/null || true ;;
    *) [ -n "${2:-}" ] && open -a "${2%.app}" 2>/dev/null || true ;;
  esac
}

jump_terminal_app() { # $1=tty (e.g. ttys003)
  osascript - "/dev/$1" <<'APPLESCRIPT'
on run argv
  set target to item 1 of argv
  tell application "Terminal"
    activate
    repeat with w in windows
      repeat with t in tabs of w
        if tty of t is target then
          set selected tab of w to t
          set index of w to 1
          return "ok"
        end if
      end repeat
    end repeat
  end tell
  error "tab not found"
end run
APPLESCRIPT
}

# Hooks may run under the Claude Code daemon (no terminal env), so recorded
# handles can be empty. Resolve at jump time: find the live claude client
# process for this session's cwd and read terminal identity from its env.
read_pid_env() { # $1=pid → sets R_* from that process's environment
  R_ITERM=""; R_CMUX=""; R_TMUX=""; R_TERM=""; R_TTY=""
  local envs
  envs=$(ps eww -o command= -p "$1" 2>/dev/null | tr ' ' '\n')
  [ -n "$envs" ] || return 1
  R_ITERM=$(grep -m1 '^ITERM_SESSION_ID=' <<<"$envs" | cut -d= -f2- || true)
  R_CMUX=$(grep -m1 '^CMUX_WORKSPACE_ID=' <<<"$envs" | cut -d= -f2- || true)
  R_TMUX=$(grep -m1 '^TMUX_PANE=' <<<"$envs" | cut -d= -f2- || true)
  R_TERM=$(grep -m1 '^TERM_PROGRAM=' <<<"$envs" | cut -d= -f2- || true)
  R_TTY=$(ps -o tty= -p "$1" 2>/dev/null | tr -d ' ')
  [ "$R_TTY" = "??" ] && R_TTY=""
  [ -n "$R_ITERM$R_CMUX$R_TMUX$R_TTY$R_TERM" ]
}

# exact resolution: the daemon knows each session's client pid
resolve_by_session() { # $1=session id
  local pid
  pid=$(fetch_agents \
    | jq -r --arg sid "$1" '[.[] | select(.sessionId == $sid and .kind == "interactive")]
                            | (first // {}).pid // empty')
  [ -n "$pid" ] || return 1
  read_pid_env "$pid"
}

jump_resolved() {
  if [ -n "$R_CMUX" ] && jump_cmux "$R_CMUX"; then return 0; fi
  if [ -n "$R_ITERM" ] && jump_iterm "$R_ITERM" >/dev/null 2>&1; then return 0; fi
  if [ -n "$R_TMUX" ] && jump_tmux "$R_TMUX" "$R_TERM"; then return 0; fi
  if [ -n "$R_TTY" ] && [ "$R_TERM" = "Apple_Terminal" ] && jump_terminal_app "$R_TTY" >/dev/null 2>&1; then return 0; fi
  # generic: no tab-level driver for this terminal — at least bring the
  # right app forward instead of opening an iTerm resume tab
  if [ -n "$R_TERM" ]; then
    case "$R_TERM" in
      iTerm.app) open -a iTerm 2>/dev/null && return 0 ;;
      Apple_Terminal) open -a Terminal 2>/dev/null && return 0 ;;
      WezTerm) open -a WezTerm 2>/dev/null && return 0 ;;
      ghostty|Ghostty) open -a Ghostty 2>/dev/null && return 0 ;;
      vscode) open -a "Visual Studio Code" 2>/dev/null && return 0 ;;
      *) open -a "${R_TERM%.app}" 2>/dev/null && return 0 ;;
    esac
  fi
  return 1
}

resolve_live() { # $1=session cwd → sets R_ITERM/R_CMUX/R_TMUX/R_TERM/R_TTY
  R_ITERM=""; R_CMUX=""; R_TMUX=""; R_TERM=""; R_TTY=""
  local want="$1" pid cmd pcwd envs
  [ -n "$want" ] || return 1
  for pid in $(pgrep -x claude 2>/dev/null; pgrep -f '/claude$' 2>/dev/null | sort -u); do
    cmd=$(ps -o command= -p "$pid" 2>/dev/null || true)
    case "$cmd" in
      *bg-pty-host*|*bg-spare*|*--output-format*) continue ;;
    esac
    pcwd=$(lsof -p "$pid" -a -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | tail -1)
    [ "$pcwd" = "$want" ] || continue
    envs=$(ps eww -o command= -p "$pid" 2>/dev/null | tr ' ' '\n')
    R_ITERM=$(grep -m1 '^ITERM_SESSION_ID=' <<<"$envs" | cut -d= -f2- || true)
    R_CMUX=$(grep -m1 '^CMUX_WORKSPACE_ID=' <<<"$envs" | cut -d= -f2- || true)
    R_TMUX=$(grep -m1 '^TMUX_PANE=' <<<"$envs" | cut -d= -f2- || true)
    R_TERM=$(grep -m1 '^TERM_PROGRAM=' <<<"$envs" | cut -d= -f2- || true)
    R_TTY=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')
    [ "$R_TTY" = "??" ] && R_TTY=""
    [ -n "$R_ITERM$R_CMUX$R_TMUX$R_TTY" ] && return 0
  done
  return 1
}

# open a new terminal tab running a command — used to resume dead sessions
# and attach to live background agents. The app's 설정 picks the terminal
# (defaults: defaultTerminal = iterm|terminal|ghostty, empty = auto).
open_tab_with() { # $1=shell command, $2=auto-press-enter after N seconds (optional)
  local cmd="$1" enter_after="${2:-}" term
  term=$(defaults read com.dean.agents-session-tracker defaultTerminal 2>/dev/null || true)
  case "$term" in
    (iterm)    tab_iterm "$cmd" "$enter_after"; return ;;
    (terminal) tab_terminal "$cmd"; return ;;
    (ghostty)
      # ghostty has no tab scripting — new window running the command;
      # fall through to auto when it isn't installed
      if open -na Ghostty --args -e "${SHELL:-/bin/zsh}" -ic "$cmd" 2>/dev/null; then
        return
      fi ;;
  esac
  if [ -d "/Applications/iTerm.app" ]; then
    tab_iterm "$cmd" "$enter_after"
  else
    tab_terminal "$cmd"
  fi
}

tab_terminal() {
  osascript -e "tell application \"Terminal\"" -e "activate" -e "do script \"$1\"" -e "end tell"
}

tab_iterm() {
  local cmd="$1" enter_after="${2:-}"
  osascript - "$cmd" "$enter_after" <<'APPLESCRIPT'
on run argv
  set cmd to item 1 of argv
  set enterAfter to item 2 of argv
  tell application "iTerm2"
    activate
    if (count of windows) = 0 then
      set w to (create window with default profile)
      set s to current session of w
    else
      tell current window
        set t to (create tab with default profile)
        set s to current session of t
      end tell
    end if
    tell s to write text cmd
    if enterAfter is not "" then
      delay (enterAfter as number)
      tell s to write text ""
    end if
  end tell
end run
APPLESCRIPT
}

resume_command() { # $1=session id → the agent-appropriate resume command
  local f="$STATE_DIR/$1.json"
  if [ -f "$f" ]; then
    if [ "$(jq -r '.agent // empty' "$f")" = "codex" ]; then
      printf 'codex resume %s' "$1"; return
    fi
  elif ls "$HOME/.codex/sessions"/*/*/*/rollout-*-"$1".jsonl >/dev/null 2>&1; then
    # archived codex session — no tracker record, but a rollout exists
    printf 'codex resume %s' "$1"; return
  fi
  printf 'claude --resume %s' "$1"
}

open_resume_tab() { # $1=cwd, $2=session id
  open_tab_with "cd $(shquote "$1") && $(resume_command "$2")"
}

# The hub: one persistent terminal tab running the 'claude agents' dashboard.
# Background-session clicks always land here — no per-click tab spawning.
focus_hub() {
  local pid cmd
  for pid in $(pgrep -f 'claude agents' 2>/dev/null); do
    cmd=$(ps -o command= -p "$pid" 2>/dev/null || true)
    case "$cmd" in *--json*|*bg-pty-host*|*bg-spare*) continue ;; esac
    case "$cmd" in *"claude agents"*) ;; *) continue ;; esac
    if read_pid_env "$pid" && jump_resolved; then return 0; fi
  done
  open_tab_with "claude agents"
}

# kept for compatibility; the hub replaces per-directory pickers
open_agents_tab() { focus_hub; }

send_esc_iterm() { # $1=ITERM_SESSION_ID — inject an Esc keypress (interrupts
                   # claude's current turn without touching the process)
  local uuid="${1##*:}"
  osascript - "$uuid" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  set target to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if id of s is target then
            tell s to write text (character id 27) newline NO
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
end run
APPLESCRIPT
}

close_iterm_by_id() { # $1=ITERM_SESSION_ID (wXtYpZ:UUID) — close that tab
  local uuid="${1##*:}"
  osascript - "$uuid" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  set target to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if id of s is target then
            tell s to close
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
end run
APPLESCRIPT
}

close_iterm_by_title() { # $1=title fragment
  osascript - "$1" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  set needle to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (name of s) contains needle then
            tell s to close
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
end run
APPLESCRIPT
}

jump_iterm_by_title() { # $1=title fragment — attach tabs are titled with the agent name
  osascript - "$1" <<'APPLESCRIPT'
on run argv
  set needle to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (name of s) contains needle then
            select s
            select t
            select w
            activate
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
  error "not found"
end run
APPLESCRIPT
}

# jump to a background session: focus a tab already attached to it (attached
# clients all show as 'claude agents', so match by tab title = agent name),
# else open a new tab attaching directly by id
jump_bg() { # $1=session id
  local short="${1:0:8}" pid name
  # exact: a live 'claude attach <short-id>' client owns the tab
  for pid in $(pgrep -f "claude attach $short" 2>/dev/null); do
    if read_pid_env "$pid" && jump_resolved; then return 0; fi
  done
  # fallback: attach tabs opened via the agents view carry the agent name
  name=$(fetch_agents \
    | jq -r --arg sid "$1" '[.[] | select(.sessionId == $sid)] | (first // {}).name // empty')
  if [ -n "$name" ] && jump_iterm_by_title "$name" >/dev/null 2>&1; then return 0; fi
  open_tab_with "claude attach $short"
}

bg_agent_status() { # $1=session id → busy|idle|empty (background kind only —
                    # interactive sessions live in a terminal we can focus)
  fetch_agents \
    | jq -r --arg sid "$1" '[.[] | select(.sessionId == $sid and .kind == "background")]
                            | (first // {}).status // empty'
}

cmd_jump() {
  local sid="$1" file
  file="$STATE_DIR/$sid.json"
  if [ ! -f "$file" ]; then
    # allow prefix match
    file=$(ls "$STATE_DIR"/"$sid"*.json 2>/dev/null | head -1 || true)
    if [ -z "$file" ]; then
      # no tracker record — the daemon may still know this session
      if resolve_by_session "$sid" && jump_resolved; then exit 0; fi
      if [ -n "$(bg_agent_status "$sid")" ]; then jump_bg "$sid" && exit 0; fi
      # completed-but-resumable daemon job (rows synthesized from --all):
      # reopen it in a resume tab at its recorded cwd
      acwd=$(claude agents --json --all 2>/dev/null \
        | jq -r --arg sid "$sid" '[.[] | select(.sessionId == $sid)] | (first // {}).cwd // empty')
      if [ -n "$acwd" ]; then
        open_resume_tab "$acwd" "$sid" >/dev/null 2>&1 && exit 0
      fi
      echo "unknown session: $sid" >&2; exit 1
    fi
  fi
  # jumping to a finished/input-waiting session acknowledges it
  case "$(jq -r '.status' "$file")" in
    finished|input)
      jq '.status = "done"' "$file" >"$file.tmp.$$" && mv "$file.tmp.$$" "$file" ;;
  esac

  local cmux_ws iterm_id tmux_pane tty term_program app pid cwd
  cmux_ws=$(jq -r '.terminal.cmux_workspace_id // empty' "$file")
  iterm_id=$(jq -r '.terminal.iterm_session_id // empty' "$file")
  tmux_pane=$(jq -r '.terminal.tmux_pane // empty' "$file")
  tty=$(jq -r '.terminal.tty // empty' "$file")
  term_program=$(jq -r '.terminal.term_program // empty' "$file")
  app=$(jq -r '.terminal.app // empty' "$file")
  pid=$(jq -r '.pid // empty' "$file")
  cwd=$(jq -r '.cwd // empty' "$file")
  local agent
  agent=$(jq -r '.agent // "claude"' "$file")

  if [ "$app" = "vscode" ]; then
    open -a "Visual Studio Code" "$cwd" 2>/dev/null && exit 0
  fi

  # fast path first: recorded handles need no claude CLI round-trip
  if [ -n "$cmux_ws" ] && jump_cmux "$cmux_ws"; then exit 0; fi
  if [ -n "$iterm_id" ] && jump_iterm "$iterm_id" >/dev/null 2>&1; then exit 0; fi
  if [ -n "$tmux_pane" ] && jump_tmux "$tmux_pane" "$term_program"; then exit 0; fi
  if [ -n "$tty" ] && [ "$term_program" = "Apple_Terminal" ] && jump_terminal_app "$tty" >/dev/null 2>&1; then exit 0; fi

  # recorded handles thin (codex sanitizes hook env) but the client process
  # is alive — read its environment for the terminal identity. Pool-owned
  # pids (daemon spare processes) carry the daemon's env, not a terminal's —
  # trusting them "succeeds" by just raising the app with no tab focus.
  if [ "$(jq -r '.owner // ""' "$file")" = "client" ] \
     && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && read_pid_env "$pid" && jump_resolved; then
    exit 0
  fi

  # one daemon lookup (cache-first), reused for every remaining strategy
  local agents entry kind daemon_pid agent_name
  agents=$(fetch_agents)
  entry=$(jq -c --arg sid "$sid" '[.[] | select(.sessionId == $sid)] | first // {}' <<<"$agents")
  kind=$(jq -r '.kind // empty' <<<"$entry")
  daemon_pid=$(jq -r '.pid // empty' <<<"$entry")
  agent_name=$(jq -r '.name // empty' <<<"$entry")

  # interactive: the daemon-reported client pid gives the exact terminal
  if [ "$kind" = "interactive" ] && [ -n "$daemon_pid" ] && read_pid_env "$daemon_pid" && jump_resolved; then
    exit 0
  fi

  # background agent: focus an attached tab by title, else attach in a new tab
  if [ "$kind" = "background" ]; then
    for apid in $(pgrep -f "claude attach ${sid:0:8}" 2>/dev/null); do
      if read_pid_env "$apid" && jump_resolved; then exit 0; fi
    done
    if [ -n "$agent_name" ] && jump_iterm_by_title "$agent_name" >/dev/null 2>&1; then exit 0; fi
    open_tab_with "claude attach ${sid:0:8}" >/dev/null 2>&1 && exit 0
  fi

  # live background agent — attach directly by id (existing attach tab wins)
  if [ -n "$(bg_agent_status "$sid")" ]; then
    jump_bg "$sid" >/dev/null 2>&1 && exit 0
  fi

  # dead session → reopen in a new tab. This has to come before the cwd
  # heuristic below: several sessions commonly share a directory, and
  # resolving by cwd would focus a different, still-running session's tab.
  if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
    open_resume_tab "$cwd" "$sid" >/dev/null 2>&1 && exit 0
  fi

  # recorded handles missing/stale — resolve from a live client process by cwd
  if resolve_live "$cwd" && jump_resolved; then exit 0; fi

  # fallback: no live terminal (desktop session etc.) — resume in a new tab
  if open_resume_tab "$cwd" "$sid" >/dev/null 2>&1; then exit 0; fi

  printf 'cd %s && %s' "$cwd" "$(resume_command "$sid")" | pbcopy 2>/dev/null || true
  osascript -e "display notification \"resume 명령 복사됨 — 터미널에 붙여넣으세요\" with title \"터미널 핸들 없는 세션\" subtitle \"${cwd/#$HOME/~}\"" 2>/dev/null || true
  echo "no jump handle for $sid — resume command copied: cd $cwd && $(resume_command "$sid")" >&2
  exit 1
}

cmd_copy_resume() {
  local sid="$1" file
  file="$STATE_DIR/$sid.json"
  [ -f "$file" ] || { echo "unknown session: $sid" >&2; exit 1; }
  local cwd
  cwd=$(jq -r '.cwd // empty' "$file")
  printf 'cd %s && %s' "$cwd" "$(resume_command "$sid")" | pbcopy
  osascript -e "display notification \"cd ${cwd/#$HOME/~} && resume …\" with title \"resume command copied\"" 2>/dev/null || true
}

# rewrite a sid-keyed state file in place; a jq failure leaves the original
write_json_file() { # write_json_file <file> <jq-filter> [jq-args…]
  local f="$1"; shift
  [ -f "$f" ] || return 0
  jq "$@" "$f" >"$f.tmp.$$" 2>/dev/null && mv "$f.tmp.$$" "$f" || rm -f "$f.tmp.$$"
  return 0
}

# a superseded parent hands its per-session assets to the fork that replaced
# it. Pin slot / custom name / drag position are 1:1 per session and have
# toggle + reorder writers, so ownership moves — unlike `group`, which stays
# an inherited lookup (parent and fork can legitimately share one group).
migrate_session_assets() { # migrate_session_assets <parent-sid> <fork-sid>
  local from="$1" to="$2" f
  for f in "$PINS_FILE" "$SORDER_FILE"; do
    write_json_file "$f" '
      if type == "array" and (index($from) != null)
      then map(if . == $from then $to else . end)
           # the fork may already hold a slot of its own — keep the first
           | reduce .[] as $x ([]; if index($x) then . else . + [$x] end)
      else . end' --arg from "$from" --arg to "$to"
  done
  # a fork that was renamed on its own keeps that name; the parent's entry is
  # left for gc_session_assets to reap once the parent record is gone
  write_json_file "$NAMES_FILE" '
    if type == "object" and has($from) and (has($to) | not)
    then .[$to] = .[$from] | del(.[$from]) else . end' --arg from "$from" --arg to "$to"
}

# sid-keyed assets outlive the records they point at — pins/names/groups/order
# entries for sessions that clean removed would otherwise accumulate forever
# (and keep occupying pin/drag slots). Archived rows can't be pinned or
# renamed, so a missing record means the session is really gone.
gc_session_assets() {
  local live f
  live=$( { for f in "$STATE_DIR"/*.json; do
              [ -e "$f" ] || continue
              basename "$f" .json
            done; } | jq -R . | jq -sc '.' 2>/dev/null || echo '[]')
  # an empty state dir reads the same as a misconfigured CST_STATE_DIR — never
  # wipe every assignment on that signal
  [ "$live" = "[]" ] && return 0
  for f in "$PINS_FILE" "$SORDER_FILE"; do
    write_json_file "$f" \
      'if type == "array" then map(select(. as $s | $live | index($s))) else . end' \
      --argjson live "$live"
  done
  # a child only ever showed its parent's group through inheritance, so
  # pruning the parent's entry would silently unset it — materialize the
  # inherited group onto the child first (same handover idea as the pin slot)
  local kids
  kids=$(jq -c -s '[.[] | select((.parent // "") != "")
                        | {sid: .session_id, parent: .parent}]' \
    "$STATE_DIR"/*.json 2>/dev/null || echo '[]')
  if [ "$kids" != "[]" ] && [ -n "$kids" ]; then
    write_json_file "$GROUPS_FILE" '
      if type == "object" then
        reduce $kids[] as $k (.;
          if (.[$k.sid] // "") == "" and (.[$k.parent] // "") != ""
             and (($live | index($k.parent)) | not)
          then .[$k.sid] = .[$k.parent] else . end)
      else . end' --argjson kids "$kids" --argjson live "$live"
  fi
  for f in "$NAMES_FILE" "$GROUPS_FILE"; do
    write_json_file "$f" \
      'if type == "object" then with_entries(select(.key as $s | $live | index($s))) else . end' \
      --argjson live "$live"
  done
  # group colors/order key off names that exist only through assignments
  local groups_left
  groups_left=$(jq -c '[.[]] | unique' "$GROUPS_FILE" 2>/dev/null || echo '[]')
  [ -n "$groups_left" ] || groups_left='[]'
  write_json_file "$GORDER_FILE" \
    'if type == "array" then map(select(. as $g | $groups | index($g))) else . end' \
    --argjson groups "$groups_left"
  write_json_file "$COLORS_FILE" \
    'if type == "object" then with_entries(select(.key as $g | $groups | index($g))) else . end' \
    --argjson groups "$groups_left"
}

cmd_clean() {
  local max_h="${1:-24}" now
  now=$(date +%s)
  for f in "$STATE_DIR"/*.json; do
    [ -e "$f" ] || continue
    local status updated mtime
    # a torn record (crashed writer) parses as nothing — under `set -e` that
    # used to abort the whole sweep. Keep it while fresh in case the write is
    # still in flight; reap it once it's past the cutoff.
    if ! status=$(jq -r '.status // ""' "$f" 2>/dev/null); then
      mtime=$(stat -f %m "$f" 2>/dev/null || echo 0)
      if [ $((now - mtime)) -gt $((max_h * 3600)) ]; then rm -f "$f"; fi
      continue
    fi
    updated=$(jq -r '.updated_at // 0' "$f" 2>/dev/null || echo 0)
    if [ "$status" = "ended" ] || [ $((now - updated)) -gt $((max_h * 3600)) ]; then
      rm -f "$f"
    fi
  done
  gc_session_assets
}

# merged view for UIs: tracked sessions + daemon session list, with dead
# sessions demoted to "gone" and untracked daemon sessions synthesized
# everything cmd_sessions_json reads, in one cheap string: record + asset
# file identities (one stat), liveness of the pids the last run depended on
# (kill is a builtin), and a coarse time bucket so the time-based decay rules
# still fire. One stat spawn, no jq.
sj_signature() { # $1=now
  local sig alive pid pids="" wp
  local watched=()
  if [ -f "$SJ_WATCH" ]; then
    while IFS= read -r wp; do [ -n "$wp" ] && watched[${#watched[@]}]="$wp"; done <"$SJ_WATCH"
  fi
  sig=$(stat -f '%N %Fm %z' "$STATE_DIR"/*.json "$GROUPS_FILE" "$NAMES_FILE" \
        "$PINS_FILE" "$COLORS_FILE" "$GORDER_FILE" "$SORDER_FILE" \
        "$AGENTS_ALL_CACHE" ${watched[@]+"${watched[@]}"} 2>/dev/null)
  [ -f "$SJ_PIDS" ] && read -r pids <"$SJ_PIDS" 2>/dev/null
  alive=""
  for pid in ${pids:-}; do
    if kill -0 "$pid" 2>/dev/null; then alive="$alive$pid+"; else alive="$alive$pid-"; fi
  done
  printf '%s|%s|%s' "$sig" "$alive" "$(( ${1:-0} / 30 ))"
}

cmd_sessions_json() {
  local now sessions agents_json extra
  now=$(date +%s)
  # nothing changed since the last run — hand back the memoised list. The
  # daemon query still ages out in the background so busy/idle keeps moving.
  local sj_sig sj_prev=""
  sj_sig=$(sj_signature "$now")
  # the signature spans lines (one per stat'd file) — read the whole file,
  # not just its first line
  # read -d '' consumes the whole (multi-line) key and reports EOF, which
  # set -e would treat as fatal
  { [ -f "$SJ_KEY" ] && IFS= read -r -d '' sj_prev <"$SJ_KEY"; } 2>/dev/null || true
  if [ -f "$SJ_CACHE" ] && [ "$sj_sig" = "$sj_prev" ]; then
    if [ $((now - $(stat -f %m "$AGENTS_ALL_CACHE" 2>/dev/null || echo 0))) -ge 10 ]; then
      { claude agents --json --all 2>/dev/null >"$AGENTS_ALL_CACHE.tmp.$$" \
        && mv "$AGENTS_ALL_CACHE.tmp.$$" "$AGENTS_ALL_CACHE"; } &
    fi
    cat "$SJ_CACHE"
    return 0
  fi
  # the daemon query is the single slowest child (~300ms) and independent of
  # everything until the busy/idle merge — fetch it concurrently, and skip it
  # entirely while the 10s cache is fresh (busy/idle may lag by that much)
  local agents_fetch="$AGENTS_CACHE.fetch.$$" agents_bgpid=""
  if [ $((now - $(stat -f %m "$AGENTS_ALL_CACHE" 2>/dev/null || echo 0))) -ge 10 ]; then
    { claude agents --json --all 2>/dev/null || printf '[]'; } >"$agents_fetch" &
    agents_bgpid=$!
  fi
  # ended tombstones exist only so the dying client's SessionEnd can't
  # resurrect the record — after an hour they're pure garbage; reap them
  # so explicit ⌃X⌃X deletes don't pile up in the state dir forever
  local reaped="" tf tm
  for tf in $(grep -El '"status": ?"ended"' "$STATE_DIR"/*.json 2>/dev/null || true); do
    tm=$(stat -f %m "$tf" 2>/dev/null || echo "$now")
    if [ $((now - tm)) -gt 3600 ]; then rm -f "$tf"; reaped=1; fi
  done
  # dead spare-pool records are permanently hidden — delete on sight. A
  # false positive is harmless: the next hook event rewrites the file.
  local tpid
  for tf in $(grep -El '"owner": ?"pool"' "$STATE_DIR"/*.json 2>/dev/null || true); do
    tpid=$(jq -r '.pid // 0' "$tf" 2>/dev/null || echo 0)
    kill -0 "$tpid" 2>/dev/null && continue
    rm -f "$tf"; reaped=1
  done
  [ -n "$reaped" ] && gc_session_assets >/dev/null 2>&1
  # tmp files a crashed writer never mv'd into place — orphans after an hour
  find "$STATE_DIR" -name '*.tmp.*' -mmin +60 -delete 2>/dev/null || true
  # fast path: every record in one jq pass. A single corrupt file (torn
  # write) fails the batch — fall back to one-by-one so it can't blank the
  # whole list.
  local all_records
  all_records=$(jq -c -s '.' "$STATE_DIR"/*.json 2>/dev/null) || all_records=""
  if [ -z "$all_records" ]; then
    all_records=$({ for rf in "$STATE_DIR"/*.json; do
        [ -e "$rf" ] || continue
        jq -c . "$rf" 2>/dev/null || true
      done; } | jq -sc '.')
  fi
  sessions=$(jq -c '[.[] | select(.status != "ended")] | sort_by(-.updated_at)' <<<"$all_records")
  # --all also returns completed (resumable) background sessions — status ""
  # marks them. Live entries come first so unique_by keeps the live one.
  local agents_all
  if [ -n "$agents_bgpid" ]; then
    wait "$agents_bgpid" 2>/dev/null || true
    agents_all=$(cat "$agents_fetch" 2>/dev/null || echo '[]')
    rm -f "$agents_fetch"
    printf '%s' "$agents_all" >"$AGENTS_ALL_CACHE.tmp.$$" 2>/dev/null \
      && mv "$AGENTS_ALL_CACHE.tmp.$$" "$AGENTS_ALL_CACHE" 2>/dev/null || true
  else
    agents_all=$(cat "$AGENTS_ALL_CACHE" 2>/dev/null || echo '[]')
  fi
  jq -e . >/dev/null 2>&1 <<<"$agents_all" || agents_all='[]'
  agents_all=$(jq -c 'sort_by(if (.status // "") == "" then 1 else 0 end) | unique_by(.sessionId)' <<<"$agents_all")
  agents_json=$(jq -c 'map(select((.status // "") != ""))' <<<"$agents_all")
  # this is the cache producer for fetch_agents (runs every 5s via the app)
  printf '%s' "$agents_json" >"$AGENTS_CACHE.tmp" 2>/dev/null && mv "$AGENTS_CACHE.tmp" "$AGENTS_CACHE" 2>/dev/null || true

  # a session moved to the background forks a NEW session id that resumes the
  # parent transcript (--fork-session --resume …/<parent>.jsonl) — map
  # parent:fork for live forks so the superseded parent row can be hidden
  local fork_pairs
  fork_pairs=$(ps -axo command= 2>/dev/null \
    | sed -n 's/.*--session-id \([0-9a-f-]\{36\}\).*--fork-session.*--resume [^ ]*\/\([0-9a-f-]\{36\}\)\.jsonl.*/\2:\1/p' || true)

  # one jq per record extracts every scalar the shell logic needs — the
  # previous field-at-a-time reads were ~8 jq spawns per record and dominated
  # the whole command's latency. Tab-separated with "-" standing in for empty
  # fields: bash 3.2's read only splits reliably on whitespace, and
  # whitespace IFS collapses adjacent separators (empty fields would shift).
  local agents_sids
  agents_sids=$(jq -r '[.[].sessionId] | join(" ")' <<<"$agents_json")
  # the loop only decides keep / drop / status-override per record; the list
  # itself is rebuilt in one jq at the end, so no record is re-serialized
  # through the shell (embedding JSON in TSV would mangle its escapes)
  local decisions
  decisions=$(jq -r '.[] | [.session_id, (.pid // "" | tostring), (.agent // "claude"),
        (.status // ""), (.owner // ""),
        (if (.title // "") != "" then "1" else "" end),
        (if .parent_resolved == true then "1" else "" end),
        (.updated_at // 0 | tostring), (.transcript_path // "")]
       | map(if . == "" then "-" else . end) | @tsv' <<<"$sessions" \
    | while IFS=$'\t' read -r sid pid agent status owner has_title presolved tu tpath; do
    local pcmd ovr="" rflag=""
    if [ "$pid" = "-" ]; then pid=""; fi
    if [ "$owner" = "-" ]; then owner=""; fi
    if [ "$has_title" = "-" ]; then has_title=""; fi
    if [ "$presolved" = "-" ]; then presolved=""; fi
    if [ "$status" = "-" ]; then status=""; fi
    if [ "$tpath" = "-" ]; then tpath=""; fi
    # conversation continued by a live fork → show the fork, not the parent
    # (unless the parent has newer activity again)
    local fork_sid=""
    case "$fork_pairs" in (*"$sid:"*)
      fork_sid=$(printf '%s\n' "$fork_pairs" | sed -n "s/^$sid://p" | head -1) ;;
    esac
    if [ -n "$fork_sid" ]; then
      # skip the parent when the fork is newer — or when the parent's own
      # client is dead (forwarded notifications keep bumping its timestamp)
      if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
        continue
      fi
      local fu
      fu=$(jq -r '.updated_at // 0' "$STATE_DIR/$fork_sid.json" 2>/dev/null || echo 0)
      if [ ! -f "$STATE_DIR/$fork_sid.json" ] || [ "$fu" -ge "$tu" ] 2>/dev/null; then
        continue
      fi
    fi
    # claude forks carry logicalParentUuid (a message uuid inside the parent
    # transcript) — resolve it to a parent session id once and cache it on
    # the record; spare-pool forks have no --fork-session cmdline to read
    if [ -z "$presolved" ] && [ "$agent" = "claude" ]; then
      local tpath0 lp parent_sid pf psid pt is_continuation jstate jparent
      is_continuation=""
      tpath0="$tpath"
      parent_sid=""
      # best-available source first: the daemon's job state records the fork
      # parent directly (spare-pool /fork sessions). NOTE: this file is an
      # undocumented internal — transcript heuristics below stay as fallback
      jstate="$HOME/.claude/jobs/${sid:0:8}/state.json"
      if [ -f "$jstate" ]; then
        jparent=$(jq -r '.forkParentSessionId // empty' "$jstate" 2>/dev/null || true)
        [ -n "$jparent" ] && [ "$jparent" != "$sid" ] && parent_sid="$jparent"
      fi
      # the recorded path goes stale when a session's cwd changes (transcripts
      # live under a per-project dir) — relocate by session id
      if [ -n "$tpath0" ] && [ ! -f "$tpath0" ]; then
        tpath0=$(ls "$HOME/.claude/projects"/*/"$sid.jsonl" 2>/dev/null | head -1 || true)
      fi
      if [ -z "$parent_sid" ] && [ -n "$tpath0" ] && [ -f "$tpath0" ]; then
        lp=$(head -n 12 "$tpath0" 2>/dev/null \
          | jq -r 'select(.logicalParentUuid) | .logicalParentUuid' 2>/dev/null | head -1 || true)
        if [ -z "$lp" ]; then
          # continuation sessions (bg jobs after compaction) carry no
          # logicalParentUuid — but their first prompt cites the original
          # transcript path ("read the full transcript at: …/<uuid>.jsonl")
          local cited
          cited=$(head -n 80 "$tpath0" 2>/dev/null \
            | grep -m1 -oE '/projects/[^" ]*[0-9a-f-]{36}\.jsonl' \
            | grep -oE '[0-9a-f-]{36}' | tail -1 || true)
          if [ -n "$cited" ] && [ "$cited" != "$sid" ] && [ -f "$STATE_DIR/$cited.json" ]; then
            parent_sid="$cited"
            is_continuation="true"
          fi
        fi
        if [ -n "$lp" ]; then
          # forks copy the parent's full history (and rewrite sessionId on
          # every line), so the uuid appears in every sibling fork too — the
          # true parent is the OLDEST session whose transcript contains it
          local best_started=""
          for pf in "$STATE_DIR"/*.json; do
            [ -e "$pf" ] || continue
            psid=$(basename "$pf" .json)
            [ "$psid" = "$sid" ] && continue
            pt=$(jq -r '.transcript_path // ""' "$pf" 2>/dev/null)
            [ -n "$pt" ] && [ -f "$pt" ] || continue
            grep -m1 -q "\"uuid\":\"$lp\"" "$pt" 2>/dev/null || continue
            local pstarted
            pstarted=$(jq -r '.started_at // 9999999999' "$pf" 2>/dev/null)
            if [ -z "$best_started" ] || [ "$pstarted" -lt "$best_started" ] 2>/dev/null; then
              best_started="$pstarted"
              parent_sid="$psid"
            fi
          done
        fi
      fi
      # cache whatever was resolved (job state, lp, or citation) so the
      # scan doesn't repeat every refresh
      rf0="$STATE_DIR/$sid.json"
      if [ -f "$rf0" ]; then
        jq --arg p "$parent_sid" --arg cont "${is_continuation:-false}" \
          '.parent_resolved = true
           | if $p != "" then .parent = $p else . end
           | if $cont == "true" then .continuation = true else . end' \
          "$rf0" >"$rf0.tmp.$$" && mv "$rf0.tmp.$$" "$rf0" && rflag="R"
      fi
    fi
    # codex has no daemon to correct a stale "running" (an Esc-interrupted
    # turn fires no Stop hook) — a rollout file untouched for 5 minutes
    # means the turn is over
    if [ "$agent" = "codex" ] && [ "$status" = "running" ]; then
      local tmtime
      if [ -n "$tpath" ] && [ -f "$tpath" ]; then
        tmtime=$(stat -f %m "$tpath" 2>/dev/null || echo 0)
        [ $((now - tmtime)) -gt 300 ] && ovr="done"
      fi
    fi
    if case " $agents_sids " in (*" $sid "*) true ;; (*) false ;; esac; then
      # daemon-listed → real session
      printf '%s\t%s\t%s\n' "$sid" "$ovr" "$rflag"
    elif [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      # dead pool-owned sessions were never real terminals — drop, don't
      # revive. Legacy records (no owner recorded) count as real only if
      # they at least earned a title.
      if [ "$owner" = "client" ] || { [ -z "$owner" ] && [ -n "$has_title" ]; }; then
        printf '%s\tgone\t%s\n' "$sid" "$rflag"
      fi
    else
      # alive but unknown to the daemon: real only if owned by a real client.
      # agents-view TUIs and spare-pool processes register phantom sessions.
      pcmd=$(ps -o command= -p "$pid" 2>/dev/null || true)
      case "$pcmd" in
        (*bg-spare*|*bg-pty-host*|*"claude agents"*|"")
          # pool-hosted but with a title = a real conversation claimed a
          # spare (e.g. a fresh bg-job fork the daemon hasn't listed yet);
          # titleless pool records are pre-warm phantoms — drop those
          [ -n "$has_title" ] && printf '%s\t%s\t%s\n' "$sid" "$ovr" "$rflag" ;;
        (*) printf '%s\t%s\t%s\n' "$sid" "$ovr" "$rflag" ;;
      esac
    fi
  done)
  # rebuild from the untouched records: keep the decided sids in order,
  # applying status overrides, and fold in lineage resolved this pass
  # lineage resolved this pass was written to the record files — re-read so
  # the parent link shows up now rather than on the next refresh
  case "$decisions" in
    (*"$(printf '\t')R"*) all_records=$(jq -c -s '.' "$STATE_DIR"/*.json 2>/dev/null || printf '%s' "$all_records") ;;
  esac
  sessions=$(jq -c -n --arg dec "$decisions" --argjson all "$all_records" '
    ($dec | split("\n") | map(select(length > 0) | split("\t"))
          | map({key: .[0], value: (.[1] // "")}) | from_entries) as $keep
    | [ $all[] | select(.session_id | in($keep))
              | if ($keep[.session_id] // "") != "" then .status = $keep[.session_id] else . end ]
    | sort_by(-.updated_at)')

  # a parent the loop above just hid hands its pin/name/order slot to the fork
  # that superseded it, so a pinned conversation stays pinned across a fork
  local visible_json lineage
  visible_json=$(jq -c '[.[].session_id]' <<<"$sessions")
  lineage=$( { printf '%s\n' "$fork_pairs"
               jq -r '.[] | select((.parent // "") != "") | "\(.parent):\(.session_id)"' \
                 <<<"$sessions"; } | grep ':' | sort -u || true)
  if [ -n "$lineage" ]; then
    local assets p f
    assets=$(cat "$PINS_FILE" "$NAMES_FILE" "$SORDER_FILE" 2>/dev/null || true)
    while IFS=: read -r p f; do
      [ -n "$p" ] && [ -n "$f" ] || continue
      # cheap gate: nothing to hand over unless the parent owns some asset
      case "$assets" in (*"$p"*) ;; (*) continue ;; esac
      # only when the parent left the view — both rows visible would mean a
      # duplicate pin rather than a handover
      jq -e --arg p "$p" --arg f "$f" \
        '(index($p) | not) and (index($f) != null)' <<<"$visible_json" >/dev/null 2>&1 || continue
      migrate_session_assets "$p" "$f"
    done <<<"$lineage"
  fi

  # fork parents hidden above — and sessions the user explicitly ended
  # (their record says so) — must not resurface as untracked daemon rows
  local fork_parents_json ended_json hidden_json
  fork_parents_json=$(printf '%s\n' "$fork_pairs" | cut -d: -f1 \
    | jq -R -s -c 'split("\n") | map(select(length > 0))' 2>/dev/null || echo '[]')
  ended_json=$(jq -c '[.[] | select(.status == "ended") | .session_id]' \
    <<<"$all_records" 2>/dev/null || echo '[]')
  hidden_json=$(jq -c -n --argjson a "$fork_parents_json" --argjson b "$ended_json" '$a + $b')
  extra=$(jq -c --argjson tracked_src "$sessions" --argjson forked "$hidden_json" '
    ([$tracked_src[].session_id]) as $tracked |
    [.[] | select([.sessionId] | inside($tracked) | not)
         | select([.sessionId] | inside($forked) | not) | {
      session_id: .sessionId,
      # "" status = completed-but-resumable (claude agents --all) → ENDED row
      status: (if .status == "busy" then "running"
               elif (.status // "") == "" then "gone"
               else "done" end),
      cwd: .cwd,
      title: (if (.name // "") != "" then .name else null end),
      updated_at: 0,
      bg: true,
      kind: .kind
    }]' <<<"$agents_all")

  # annotate tracked rows with the daemon's kind + name so UIs can label
  # daemon-hosted sessions correctly; attach user-defined group names
  # all six sid-keyed asset files in one jq pass — each is parsed inside a
  # try so a torn write falls back to its empty default instead of blanking
  # the list (the old cat+validate pair per file cost 12 spawns)
  local assets
  for f in "$GROUPS_FILE" "$NAMES_FILE" "$COLORS_FILE"; do
    [ -f "$f" ] || printf '{}' >"$f" 2>/dev/null || true
  done
  for f in "$PINS_FILE" "$GORDER_FILE" "$SORDER_FILE"; do
    [ -f "$f" ] || printf '[]' >"$f" 2>/dev/null || true
  done
  assets=$(jq -n -c \
    --rawfile g "$GROUPS_FILE" --rawfile n "$NAMES_FILE" --rawfile c "$COLORS_FILE" \
    --rawfile p "$PINS_FILE" --rawfile o "$GORDER_FILE" --rawfile so "$SORDER_FILE" '
    def obj(x): (try (x | fromjson) catch {}) | if type == "object" then . else {} end;
    def arr(x): (try (x | fromjson) catch []) | if type == "array" then . else [] end;
    {groups: obj($g), names: obj($n), colors: obj($c),
     pins: arr($p), gorder: arr($o), sorder: arr($so)}' 2>/dev/null \
    || printf '%s' '{"groups":{},"names":{},"colors":{},"pins":[],"gorder":[],"sorder":[]}')
  local groups_json names_json pins_json colors_json order_json sorder_json
  groups_json="$assets"; names_json="$assets"; pins_json="$assets"
  colors_json="$assets"; order_json="$assets"; sorder_json="$assets"
  # fork lineage for the UI: a fork nests under its parent when both are shown
  local pairs_json
  pairs_json=$(printf '%s\n' "$fork_pairs" \
    | jq -R -s -c 'split("\n") | map(select(test(":")) | split(":") | {p: .[0], f: .[1]})' \
      2>/dev/null || echo '[]')
  local sj_out
  sj_out=$(jq --argjson extra "$extra" --argjson agents "$agents_json" \
     --argjson a "$assets" --argjson pairs "$pairs_json" '
    ($a.groups) as $groups | ($a.names) as $names | ($a.pins) as $pins
    | ($a.colors) as $colors | ($a.gorder) as $gorder | ($a.sorder) as $sorder |
    map(. as $s
      | ($agents | map(select(.sessionId == $s.session_id)) | first // {}) as $a
      | $s + {kind: ($a.kind // $s.kind), title: ($s.title // $a.name)}
      | .parent = ($s.parent // ([$pairs[] | select(.f == $s.session_id) | .p] | first) // null)
      # daemon status corrects stale hook state (permission waits stay
      # waiting) — applies to interactive sessions too, e.g. an Esc-
      # interrupted turn never fires the Stop hook
      | if ($a.status // "") == "busy" and (.status | IN("waiting", "finished", "input") | not) then .status = "running"
        elif ($a.status // "") == "idle" and .status == "running" then .status = "done"
        else . end
      # unacknowledged results / input waits decay to idle after 30 minutes
      | if (.status | IN("finished", "input")) and (now - (.updated_at // 0)) > 1800 then .status = "done" else . end)
    | . + $extra
    | map(. + {group: ($groups[.session_id]
                       # a fork inherits its parent'\''s group unless assigned
                       // (if .parent then ($groups[.parent] // null) else null end)),
               title: ($names[.session_id] // .title),
               pin_order: (.session_id as $s | ($pins | index($s)))})
    | map(. + {group_color: (if .group then ($colors[.group] // null) else null end),
               group_order: (if .group then (.group as $g | ($gorder | index($g))) else null end),
               sort_order: (.session_id as $s | ($sorder | index($s)))})' <<<"$sessions")
  printf '%s\n' "$sj_out"
  # memoise: the pid list feeds the next run's liveness check, and the key is
  # recomputed after the writes so reaps/lineage updates land in it
  jq -r '[.[] | .pid // empty] | join(" ")' <<<"$all_records" >"$SJ_PIDS.tmp.$$" 2>/dev/null \
    && mv "$SJ_PIDS.tmp.$$" "$SJ_PIDS" 2>/dev/null || rm -f "$SJ_PIDS.tmp.$$"
  jq -r '.[] | select((.agent // "") == "codex") | .transcript_path // empty' \
    <<<"$all_records" >"$SJ_WATCH.tmp.$$" 2>/dev/null \
    && mv "$SJ_WATCH.tmp.$$" "$SJ_WATCH" 2>/dev/null || rm -f "$SJ_WATCH.tmp.$$"
  printf '%s\n' "$sj_out" >"$SJ_CACHE.tmp.$$" 2>/dev/null \
    && mv "$SJ_CACHE.tmp.$$" "$SJ_CACHE" 2>/dev/null || rm -f "$SJ_CACHE.tmp.$$"
  sj_signature "$now" >"$SJ_KEY.tmp.$$" 2>/dev/null \
    && mv "$SJ_KEY.tmp.$$" "$SJ_KEY" 2>/dev/null || rm -f "$SJ_KEY.tmp.$$"
}

case "${1:-list}" in
  list) cmd_list ;;
  sessions-json) cmd_sessions_json ;;
  jump) [ $# -ge 2 ] || { echo "usage: ast jump <session-id>" >&2; exit 1; }; cmd_jump "$2" ;;
  copy-resume) [ $# -ge 2 ] || { echo "usage: ast copy-resume <session-id>" >&2; exit 1; }; cmd_copy_resume "$2" ;;
  group)
    # ast group <session-id> <group-name>   ("-" removes the assignment)
    [ $# -ge 3 ] || { echo "usage: ast group <session-id> <name|->" >&2; exit 1; }
    existing=$(cat "$GROUPS_FILE" 2>/dev/null || echo '{}')
    jq -e . >/dev/null 2>&1 <<<"$existing" || existing='{}'
    if [ "$3" = "-" ]; then
      jq --arg sid "$2" 'del(.[$sid])' <<<"$existing" >"$GROUPS_FILE.tmp"
    else
      jq --arg sid "$2" --arg g "$3" '.[$sid] = $g' <<<"$existing" >"$GROUPS_FILE.tmp"
    fi
    mv "$GROUPS_FILE.tmp" "$GROUPS_FILE"
    ;;
  peek)
    # ast peek <session-id> — last assistant reply text (for hover preview)
    [ $# -ge 2 ] || { echo "usage: ast peek <session-id>" >&2; exit 1; }
    f=$(ls "$STATE_DIR"/"$2"*.json 2>/dev/null | head -1 || true)
    [ -n "$f" ] || exit 0
    t=$(jq -r '.transcript_path // empty' "$f")
    if [ -z "$t" ] || [ ! -f "$t" ]; then
      cwd=$(jq -r '.cwd // empty' "$f"); sid=$(jq -r '.session_id' "$f")
      slug=$(sed 's/[\/._]/-/g' <<<"$cwd")
      t="$HOME/.claude/projects/$slug/$sid.jsonl"
    fi
    [ -f "$t" ] || exit 0
    case "$t" in
      (*/.codex/*)
        tail -n 300 "$t" 2>/dev/null \
          | jq -r 'select(.type == "response_item") | .payload
                   | select(.type == "message" and .role == "assistant")
                   | ((.content // []) | map(select(.type == "output_text") | .text) | join(""))' 2>/dev/null \
          | grep -v '^\s*$' | tail -n 8 | head -c 600 || true ;;
      (*)
        tail -n 300 "$t" 2>/dev/null \
          | jq -r 'select(.type == "assistant") | .message.content
                   | if type == "array" then (map(select(.type == "text") | .text) | join("")) else tostring end' 2>/dev/null \
          | grep -v '^\s*$' | tail -n 8 | head -c 600 || true ;;
    esac
    ;;
  retitle)
    # ast retitle <session-id> — name the session from its own transcript.
    # Deliberately terminal-independent: reads the conversation, asks claude
    # headlessly for a short title, stores it as the user-name override.
    [ $# -ge 2 ] || { echo "usage: ast retitle <session-id>" >&2; exit 1; }
    f=$(ls "$STATE_DIR"/"$2"*.json 2>/dev/null | head -1 || true)
    [ -n "$f" ] || { echo "unknown session: $2" >&2; exit 1; }
    rsid=$(jq -r '.session_id' "$f")
    rt=$(jq -r '.transcript_path // ""' "$f")
    if [ -z "$rt" ] || [ ! -f "$rt" ]; then
      rt=$(ls "$HOME/.claude/projects"/*/"$rsid.jsonl" 2>/dev/null | head -1 || true)
    fi
    [ -f "$rt" ] || { echo "no transcript for $rsid" >&2; exit 1; }
    case "$rt" in
      (*/.codex/*)
        convo=$( (head -n 120 "$rt" 2>/dev/null \
          | jq -r 'select(.type=="response_item") | .payload
                   | select(.type=="message")
                   | ((.content // []) | map(.text // "") | join(" "))
                   | select(length > 0) | select(startswith("<") | not)' 2>/dev/null \
          | head -n 8 | cut -c1-400) || true) ;;
      (*)
        convo=$( (head -n 120 "$rt" 2>/dev/null \
          | jq -r 'select(.type=="user" or .type=="assistant") | .message.content
                   | if type=="string" then . else ((map(select(.type=="text")) | first // {}).text // empty) end
                   | select(length > 0)
                   | select(test("This session is being continued|Primary Request and Intent") | not)' 2>/dev/null \
          | head -n 8 | cut -c1-400) || true) ;;
    esac
    [ -n "$convo" ] || { echo "empty transcript" >&2; exit 1; }
    newname=$(CST_INTERNAL=1 claude -p --strict-mcp-config "다음 대화에 어울리는 짧은 제목을 지어라. 한국어 대화면 한국어로, 20자 이내, 조사·마침표 없이 명사구로. 제목만 출력하고 다른 말은 하지 마라.

$convo" 2>/dev/null \
      | tr -d '\r"' | grep -v '^\s*$' | head -n 1 | cut -c1-40 || true)
    [ -n "$newname" ] || { echo "no title generated" >&2; exit 1; }
    "$0" title "$rsid" "$newname" --no-sync
    printf '%s\n' "$newname"
    ;;
  focused-sid)
    # session id of the terminal tab the user is actually looking at, if any.
    # Notifications use this to stay quiet about a session already on screen.
    front=$(lsappinfo info -only bundleid "$(lsappinfo front 2>/dev/null)" 2>/dev/null \
      | cut -d'"' -f4 || true)
    case "$front" in
      (com.googlecode.iterm2)
        uuid=$(osascript -e 'tell application "iTerm2" to return id of current session of current tab of current window' 2>/dev/null || true)
        [ -n "$uuid" ] || exit 0
        f=$(grep -l "$uuid" "$STATE_DIR"/*.json 2>/dev/null | head -1 || true)
        if [ -n "$f" ]; then basename "$f" .json; exit 0; fi
        # daemon-hosted sessions record no terminal of their own — identify the
        # live agent (or attach client) sitting in that tab instead
        for fpid in $(pgrep -f 'claude|codex' 2>/dev/null); do
          fenv=$(ps eww -o command= -p "$fpid" 2>/dev/null | tr ' ' '\n' \
            | grep -m1 '^ITERM_SESSION_ID=' | cut -d= -f2- || true)
          case "$fenv" in (*"$uuid"*) ;; (*) continue ;; esac
          fcmd=$(ps -o command= -p "$fpid" 2>/dev/null || true)
          case "$fcmd" in
            (*" attach "*)
              short=${fcmd##* attach }; short=${short%% *}
              g=$(ls "$STATE_DIR"/"$short"*.json 2>/dev/null | head -1 || true)
              [ -n "$g" ] && { basename "$g" .json; exit 0; } ;;
          esac
          g=$(grep -l "\"pid\": *$fpid," "$STATE_DIR"/*.json 2>/dev/null | head -1 || true)
          [ -n "$g" ] && { basename "$g" .json; exit 0; }
        done
        ;;
      (com.apple.Terminal)
        ftty=$(osascript -e 'tell application "Terminal" to return tty of selected tab of front window' 2>/dev/null || true)
        [ -n "$ftty" ] || exit 0
        f=$(grep -l "\"tty\": *\"${ftty##*/}\"" "$STATE_DIR"/*.json 2>/dev/null | head -1 || true)
        [ -n "$f" ] && basename "$f" .json
        ;;
    esac
    exit 0
    ;;
  input-kind)
    # ast input-kind <sid> — what kind of reply the session is waiting on:
    # question (AskUserQuestion) | plan (ExitPlanMode) | reply (anything else)
    [ $# -ge 2 ] || { echo "reply"; exit 0; }
    f=$(ls "$STATE_DIR"/"$2"*.json 2>/dev/null | head -1 || true)
    t=""
    [ -n "$f" ] && t=$(jq -r '.transcript_path // empty' "$f")
    if [ -z "$t" ] || [ ! -f "$t" ]; then echo "reply"; exit 0; fi
    last_tool=$(tail -n 120 "$t" 2>/dev/null \
      | jq -r 'select(.type=="assistant") | .message.content
               | if type=="array" then (map(select(.type=="tool_use") | .name) | join(",")) else empty end' 2>/dev/null \
      | grep -v '^$' | tail -1 || true)
    case "$last_tool" in
      (*AskUserQuestion*) echo "question" ;;
      (*ExitPlanMode*)    echo "plan" ;;
      (*)                 echo "reply" ;;
    esac
    ;;
  send)
    # ast send <session-id> <message…> — run one headless turn in the
    # background; the panel's status tracking shows the result
    [ $# -ge 3 ] || { echo "usage: ast send <session-id> <message>" >&2; exit 1; }
    sid="$2"; shift 2; msg="$*"
    f=$(ls "$STATE_DIR"/"$sid"*.json 2>/dev/null | head -1 || true)
    cwd=$([ -n "$f" ] && jq -r '.cwd // empty' "$f" || echo "$HOME")
    agent=$([ -n "$f" ] && jq -r '.agent // "claude"' "$f" || echo "claude")
    (
      cd "$cwd" 2>/dev/null || cd "$HOME"
      if [ "$agent" = "codex" ]; then
        codex exec resume "$sid" "$msg" --skip-git-repo-check </dev/null
      else
        claude -p --resume "$sid" "$msg"
      fi
    ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
    ;;
  type-into)
    # ast type-into <session-id> <text…> — type text straight into the
    # session's terminal (submits). Lets TUI-only slash commands (/resume…)
    # work from the panel, unlike the headless `send`.
    QUIET=""
    if [ "${2:-}" = "--quiet" ]; then QUIET=1; shift; fi
    [ $# -ge 3 ] || { echo "usage: ast type-into [--quiet] <session-id> <text>" >&2; exit 1; }
    sid="$2"; shift 2; msg="$*"
    f=$(ls "$STATE_DIR"/"$sid"*.json 2>/dev/null | head -1 || true)
    iterm_id=""
    [ -n "$f" ] && iterm_id=$(jq -r '.terminal.iterm_session_id // empty' "$f")
    if [ -z "$iterm_id" ] && [ -n "$f" ]; then
      tpid=$(jq -r '.pid // empty' "$f")
      [ -n "$tpid" ] && iterm_id=$(ps eww -o command= -p "$tpid" 2>/dev/null | tr ' ' '\n' \
        | grep -m1 '^ITERM_SESSION_ID=' | cut -d= -f2- || true)
    fi
    # daemon-hosted session (bg-spare has no terminal env) — the live attach
    # client's tab forwards keystrokes through the pty, so type there
    if [ -z "$iterm_id" ]; then
      for apid in $(pgrep -f "claude attach ${sid:0:8}" 2>/dev/null); do
        if read_pid_env "$apid" && [ -n "$R_ITERM" ]; then
          iterm_id="$R_ITERM"
          break
        fi
      done
    fi
    if [ -z "$iterm_id" ]; then
      osascript -e 'display notification "터미널 핸들이 없어 입력 불가 (헤드리스 전송을 쓰세요)" with title "Agents Session Tracker"' 2>/dev/null || true
      exit 1
    fi
    uuid="${iterm_id##*:}"
    # a quiet injection must not pull iTerm forward — remember who is in front
    # and hand focus straight back if the AppleScript raises it
    prev_front=""
    if [ -n "${QUIET:-}" ]; then
      prev_front=$(lsappinfo info -only bundleid "$(lsappinfo front 2>/dev/null)" 2>/dev/null \
        | cut -d'"' -f4 || true)
    fi
    osascript - "$uuid" "$msg" "${QUIET:-0}" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  set target to item 1 of argv
  set msg to item 2 of argv
  set quiet to item 3 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if id of s is target then
            tell s to write text msg
            if quiet is not "1" then
              select s
              select t
              select w
              activate
            end if
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
  end tell
end run
APPLESCRIPT
    if [ -n "$prev_front" ] && [ "$prev_front" != "com.googlecode.iterm2" ]; then
      now_front=$(lsappinfo info -only bundleid "$(lsappinfo front 2>/dev/null)" 2>/dev/null \
        | cut -d'"' -f4 || true)
      [ "$now_front" != "$prev_front" ] && open -g -b "$prev_front" 2>/dev/null || true
    fi
    ;;
  run-command)
    # ast run-command <name> — execute a user command from commands.json.
    # Command strings starting with '@' run silently in the background
    # (with a completion notification); otherwise they open in a new tab.
    [ $# -ge 2 ] || { echo "usage: ast run-command <name> [arg]" >&2; exit 1; }
    CMDS_FILE="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}/commands.json"
    cmd=$(jq -r --arg n "$2" '.[$n] // empty' "$CMDS_FILE" 2>/dev/null || true)
    [ -n "$cmd" ] || { echo "unknown command: $2" >&2; exit 1; }
    # keyword commands take an argument via the {query} placeholder; an
    # optional 4th arg fills {prompt} (shell-quoted), e.g. an initial
    # prompt for a freshly started claude session
    arg="${3:-}"
    prompt="${4:-}"
    cmd="${cmd//\{query\}/$arg}"
    case "$cmd" in
      *"{prompt}"*)
        if [ -n "$prompt" ]; then
          q=$(shquote "$prompt")
          cmd="${cmd//\{prompt\}/$q}"
        else
          cmd="${cmd// \{prompt\}/}"
          cmd="${cmd//\{prompt\}/}"
        fi
        ;;
    esac
    if [ "${cmd#@}" != "$cmd" ]; then
      (
        if bash -lc "${cmd#@}" >/dev/null 2>&1; then
          osascript -e "display notification \"완료\" with title \"> $2\"" 2>/dev/null
        else
          osascript -e "display notification \"실패\" with title \"> $2\"" 2>/dev/null
        fi
      ) >/dev/null 2>&1 &
      disown 2>/dev/null || true
    else
      open_tab_with "$cmd"
    fi
    ;;
  new-session)
    # ast new-session <dir> [claude|codex] [initial prompt…] — open a new
    # session in a fresh tab, optionally starting on a prompt (the skill
    # palette uses this to run "/review" etc. in a clean session)
    [ $# -ge 2 ] || { echo "usage: ast new-session <dir> [agent] [prompt]" >&2; exit 1; }
    agent_cmd="claude"
    [ "${3:-}" = "codex" ] && agent_cmd="codex"
    ns_dir="$2"
    ns_prompt=""
    if [ $# -ge 4 ]; then shift 3; ns_prompt="$*"; fi
    if [ -n "$ns_prompt" ]; then
      open_tab_with "cd $(shquote "$ns_dir") && $agent_cmd $(shquote "$ns_prompt")"
    else
      open_tab_with "cd $(shquote "$ns_dir") && $agent_cmd"
    fi
    ;;
  resume-tab)
    # ast resume-tab <session-id> <cwd> — reopen an archived session in a tab
    [ $# -ge 3 ] || { echo "usage: ast resume-tab <session-id> <cwd>" >&2; exit 1; }
    open_resume_tab "$3" "$2"
    ;;
  archive-search)
    # ast archive-search <query> — full-text grep over claude + codex
    # transcripts, newest first. Live sessions are included so the panel
    # can surface content matches on running work too.
    [ $# -ge 2 ] || { echo "[]"; exit 0; }
    q="$2"
    # newest-first, in escalating chunks: only 12 hits are shown, and a match
    # is nearly always in recent work — scanning the whole corpus (hundreds of
    # MB) on every keystroke cost seconds. ripgrep when present, grep otherwise.
    all_files=$(find "$HOME/.claude/projects" "$HOME/.codex/sessions" \
        -name '*.jsonl' -type f -print0 2>/dev/null \
      | xargs -0 stat -f '%m %N' 2>/dev/null | sort -rn | cut -d' ' -f2- || true)
    search_chunk() { # stdin: file list → matching paths, order not preserved
      if command -v rg >/dev/null 2>&1; then
        tr '\n' '\0' | xargs -0 rg -l -i -F --no-messages -- "$q" 2>/dev/null || true
      else
        tr '\n' '\0' | xargs -0 grep -l -i -m1 -F -- "$q" 2>/dev/null || true
      fi
    }
    hits=""
    nhits=0
    scanned=0
    for chunk in 80 400 100000; do
      [ "$scanned" -ge "$chunk" ] && continue
      slice=$(printf '%s\n' "$all_files" | sed -n "$((scanned + 1)),${chunk}p")
      [ -n "$slice" ] || break
      matched=$(printf '%s\n' "$slice" | search_chunk)
      scanned="$chunk"
      # keep the newest-first order of the slice, cap at 12 overall
      if [ -n "$matched" ]; then
        while IFS= read -r cand; do
          [ -n "$cand" ] || continue
          case "$matched" in (*"$cand"*) ;; (*) continue ;; esac
          case "$hits" in (*"$cand"*) continue ;; esac
          hits="$hits$cand
"
          nhits=$((nhits + 1))
          [ "$nhits" -ge 12 ] && break
        done <<<"$slice"
      fi
      [ "$nhits" -ge 12 ] && break
    done
    hits=$(printf '%s' "$hits")
    out="[]"
    seen=""
    while IFS= read -r t; do
      [ -n "$t" ] || continue
      base=$(basename "$t" .jsonl)
      agent="claude"; sid="$base"; cwd=""; title=""
      case "$t" in
        */.codex/*)
          agent="codex"
          sid="${base:${#base}-36}"  # rollout-<timestamp>-<uuid>
          cwd=$(head -n 2 "$t" 2>/dev/null \
            | jq -r 'select(.type=="session_meta") | .payload.cwd // empty' 2>/dev/null | grep -m1 . || true)
          title=$( (head -n 200 "$t" 2>/dev/null \
            | jq -r 'select(.type=="response_item") | .payload
                     | select(.type=="message" and .role=="user")
                     | ((.content // []) | map(select(.type=="input_text")) | first // {}).text // empty
                     | select(length > 0) | select(startswith("<") | not)' 2>/dev/null \
            | head -n 1 | cut -c1-60) || true)
          ;;
        *)
          case "$sid" in agent-*) continue ;; esac  # subagent transcripts
          cwd=$(head -n 5 "$t" 2>/dev/null | jq -r '.cwd // empty' 2>/dev/null | grep -m1 . || true)
          title=$( (head -n 5 "$t" 2>/dev/null \
            | jq -r 'select(.type=="ai-title") | .aiTitle // empty' 2>/dev/null | head -n 1) || true)
          # the summary probe reads the whole file, so it now runs only when
          # the two head-bounded probes came up empty
          if [ -z "$title" ]; then
            # compaction summaries are one giant message — drop them whole,
            # or their body lines ("1. Primary Request…") become titles
            title=$( (head -n 80 "$t" 2>/dev/null \
              | jq -r 'select(.type=="user") | .message.content
                       | if type=="string" then . else ((map(select(.type=="text")) | first // {}).text // empty) end
                       | select(test("This session is being continued|Primary Request and Intent|^(Summary|Analysis):") | not)' 2>/dev/null \
              | grep -vE '^\s*(<|$)' \
              | head -n 1 | cut -c1-60) || true)
          fi
          if [ -z "$title" ]; then
            title=$( (grep '"type":"summary"' "$t" 2>/dev/null | tail -1 \
              | jq -r '.summary // empty' 2>/dev/null) || true)
          fi
          ;;
      esac
      case " $seen " in *" $sid "*) continue ;; esac
      seen="$seen $sid"
      mt=$(stat -f %m "$t" 2>/dev/null || echo 0)
      out=$(jq --arg sid "$sid" --arg cwd "$cwd" --arg title "$title" \
               --arg agent "$agent" --argjson mt "$mt" \
        '. + [{session_id: $sid, cwd: $cwd, title: (if $title == "" then null else $title end),
               status: "archived", updated_at: $mt, agent: $agent}]' <<<"$out")
    done <<<"$hits"
    printf '%s\n' "$out"
    ;;
  order-insert)
    # ast order-insert <sid> <before-sid|end> — manual ordering within
    # status sections (session-order.json)
    [ $# -ge 3 ] || { echo "usage: ast order-insert <sid> <before-sid|end>" >&2; exit 1; }
    ORDER_FILE="$SORDER_FILE"
    existing=$(cat "$ORDER_FILE" 2>/dev/null || echo '[]')
    jq -e 'type == "array"' >/dev/null 2>&1 <<<"$existing" || existing='[]'
    jq --arg sid "$2" --arg before "$3" '
      map(select(. != $sid))
      | if $before == "end" then . + [$sid]
        else (index($before) // length) as $i | .[:$i] + [$sid] + .[$i:] end' \
      <<<"$existing" >"$ORDER_FILE.tmp" && mv "$ORDER_FILE.tmp" "$ORDER_FILE"
    ;;
  pin-insert)
    # ast pin-insert <sid> <before-sid|end> — reorder pins
    [ $# -ge 3 ] || { echo "usage: ast pin-insert <sid> <before-sid|end>" >&2; exit 1; }
    existing=$(cat "$PINS_FILE" 2>/dev/null || echo '[]')
    jq -e 'type == "array"' >/dev/null 2>&1 <<<"$existing" || existing='[]'
    jq --arg sid "$2" --arg before "$3" '
      map(select(. != $sid))
      | if $before == "end" then . + [$sid]
        else (index($before) // length) as $i | .[:$i] + [$sid] + .[$i:] end' \
      <<<"$existing" >"$PINS_FILE.tmp" && mv "$PINS_FILE.tmp" "$PINS_FILE"
    ;;
  group-color)
    # ast group-color <group> <color|-> — colors.json (named accents)
    [ $# -ge 3 ] || { echo "usage: ast group-color <group> <color|->" >&2; exit 1; }
    existing=$(cat "$COLORS_FILE" 2>/dev/null || echo '{}')
    jq -e . >/dev/null 2>&1 <<<"$existing" || existing='{}'
    if [ "$3" = "-" ]; then
      jq --arg g "$2" 'del(.[$g])' <<<"$existing" >"$COLORS_FILE.tmp"
    else
      jq --arg g "$2" --arg c "$3" '.[$g] = $c' <<<"$existing" >"$COLORS_FILE.tmp"
    fi
    mv "$COLORS_FILE.tmp" "$COLORS_FILE"
    ;;
  pin)
    # ast pin <session-id> — toggle pin-to-top (pins.json keeps pin order)
    [ $# -ge 2 ] || { echo "usage: ast pin <session-id>" >&2; exit 1; }
    existing=$(cat "$PINS_FILE" 2>/dev/null || echo '[]')
    jq -e 'type == "array"' >/dev/null 2>&1 <<<"$existing" || existing='[]'
    jq --arg sid "$2" \
      'if index($sid) then map(select(. != $sid)) else . + [$sid] end' \
      <<<"$existing" >"$PINS_FILE.tmp" && mv "$PINS_FILE.tmp" "$PINS_FILE"
    ;;
  title)
    # ast title <session-id> <custom-name>   ("-" reverts to the auto title)
    [ $# -ge 3 ] || { echo "usage: ast title <session-id> <name|->" >&2; exit 1; }
    existing=$(cat "$NAMES_FILE" 2>/dev/null || echo '{}')
    jq -e . >/dev/null 2>&1 <<<"$existing" || existing='{}'
    if [ "$3" = "-" ]; then
      jq --arg sid "$2" 'del(.[$sid])' <<<"$existing" >"$NAMES_FILE.tmp"
    else
      jq --arg sid "$2" --arg t "$3" '.[$sid] = $t' <<<"$existing" >"$NAMES_FILE.tmp"
    fi
    mv "$NAMES_FILE.tmp" "$NAMES_FILE"
    # --no-sync keeps this purely local (ast retitle wants no terminal at all)
    SYNC=1
    case "${4:-}" in (--no-sync) SYNC="" ;; esac
    # sync claude's own session name too (/rename is REPL-only, so it gets
    # typed into the live tab without stealing focus). Slash commands are
    # processed locally even mid-turn, so running is fine — but not while a
    # dialog owns the keyboard (waiting = permission prompt, input = option
    # picker), where injected keys would operate the dialog.
    if [ "$3" != "-" ] && [ -n "$SYNC" ]; then
      f="$STATE_DIR/$2.json"
      if [ -f "$f" ]; then
        IFS=$'\t' read -r r_agent r_pid r_status <<<"$(jq -r \
          '[(.agent // "claude"), (.pid // 0 | tostring), (.status // "")] | @tsv' "$f")"
        if [ "$r_agent" = "claude" ] && kill -0 "$r_pid" 2>/dev/null; then
          case "$r_status" in
            (done|finished|running) "$0" type-into --quiet "$2" "/rename $3" >/dev/null 2>&1 || true ;;
          esac
        fi
      fi
    fi
    ;;
  group-move)
    # ast group-move <name> <before-name|end> — reorder groups
    [ $# -ge 3 ] || { echo "usage: ast group-move <name> <before|end>" >&2; exit 1; }
    ORDER_FILE="$GORDER_FILE"
    existing=$(cat "$ORDER_FILE" 2>/dev/null || echo '[]')
    jq -e 'type == "array"' >/dev/null 2>&1 <<<"$existing" || existing='[]'
    jq --arg g "$2" --arg before "$3" '
      map(select(. != $g))
      | if $before == "end" then . + [$g]
        else (index($before) // length) as $i | .[:$i] + [$g] + .[$i:] end' \
      <<<"$existing" >"$ORDER_FILE.tmp" && mv "$ORDER_FILE.tmp" "$ORDER_FILE"
    ;;
  group-rename)
    [ $# -ge 3 ] || { echo "usage: ast group-rename <old> <new>" >&2; exit 1; }
    existing=$(cat "$GROUPS_FILE" 2>/dev/null || echo '{}')
    jq -e . >/dev/null 2>&1 <<<"$existing" || existing='{}'
    jq --arg old "$2" --arg new "$3" \
      'with_entries(if .value == $old then .value = $new else . end)' \
      <<<"$existing" >"$GROUPS_FILE.tmp" && mv "$GROUPS_FILE.tmp" "$GROUPS_FILE"
    ;;
  group-dissolve)
    [ $# -ge 2 ] || { echo "usage: ast group-dissolve <name>" >&2; exit 1; }
    existing=$(cat "$GROUPS_FILE" 2>/dev/null || echo '{}')
    jq -e . >/dev/null 2>&1 <<<"$existing" || existing='{}'
    jq --arg g "$2" 'with_entries(select(.value != $g))' \
      <<<"$existing" >"$GROUPS_FILE.tmp" && mv "$GROUPS_FILE.tmp" "$GROUPS_FILE"
    ;;
  jump-index)
    # ast jump-index <n> — open the Nth session in canonical order
    # (waiting > finished > running > idle > gone, most recent first)
    [ $# -ge 2 ] || { echo "usage: ast jump-index <n>" >&2; exit 1; }
    sid=$(cmd_sessions_json | jq -r --argjson i "$(($2 - 1))" '
      def pr: if .status == "waiting" then 0 elif .status == "input" then 1
              elif .status == "finished" then 2 elif .status == "running" then 3
              elif .status == "done" then 4 else 5 end;
      sort_by([pr, -(.updated_at // 0)]) | (.[$i] // {}).session_id // empty')
    [ -n "$sid" ] || exit 0
    cmd_jump "$sid"
    ;;
  attention)
    # jump straight to the top-priority attention session
    # (waiting > finished > running, most recent first)
    sid=$(cmd_sessions_json | jq -r '
      map(select(.status | IN("waiting", "input", "finished", "running")))
      | sort_by((if .status == "waiting" then 0 elif .status == "input" then 1
                 elif .status == "finished" then 2 else 3 end),
                -(.updated_at // 0))
      | (first // {}).session_id // empty')
    if [ -z "$sid" ]; then
      osascript -e 'display notification "지금 주의 필요한 세션 없음" with title "Agents Session Tracker"' 2>/dev/null || true
      exit 0
    fi
    cmd_jump "$sid"
    ;;
  stop-session)
    # ast stop-session <session-id> — stop the session; it stays listed as 💤
    # (resumable). Fast: the record's own pid/handles avoid a daemon CLI
    # round-trip, and AppleScript runs in the background.
    [ $# -ge 2 ] || { echo "usage: ast stop-session <session-id>" >&2; exit 1; }
    f=$(ls "$STATE_DIR"/"$2"*.json 2>/dev/null | head -1 || true)
    cpid=""; rowner=""
    if [ -n "$f" ]; then
      cpid=$(jq -r '.pid // empty' "$f")
      rowner=$(jq -r '.owner // empty' "$f")
    fi
    if [ -n "$f" ] && [ "$rowner" = "client" ] && [ -n "$cpid" ] && kill -0 "$cpid" 2>/dev/null; then
      # client-owned live session (claude or codex) — record-driven
      rstatus=$(jq -r '.status // empty' "$f")
      iterm_id=$(jq -r '.terminal.iterm_session_id // empty' "$f")
      if [ -z "$iterm_id" ]; then
        iterm_id=$(ps eww -o command= -p "$cpid" 2>/dev/null | tr ' ' '\n' \
          | grep -m1 '^ITERM_SESSION_ID=' | cut -d= -f2- || true)
      fi
      if [ "$rstatus" = "running" ] || [ "$rstatus" = "waiting" ]; then
        # running turn: inject Esc (stop-generation) — a SIGINT signal
        # would make the agent exit to the shell
        [ -n "$iterm_id" ] && send_esc_iterm "$iterm_id" >/dev/null 2>&1 &
        jq --arg it "$iterm_id" \
          '.status = "done" | if $it != "" then .terminal.iterm_session_id = $it else . end' \
          "$f" >"$f.tmp.$$" && mv "$f.tmp.$$" "$f"
      else
        # idle at the prompt: first press just shelves it as 💤 — the
        # process and tab stay untouched until a second press ends it
        jq --arg it "$iterm_id" \
          '.status = "gone" | .owner = "client"
           | if $it != "" then .terminal.iterm_session_id = $it else . end' \
          "$f" >"$f.tmp.$$" && mv "$f.tmp.$$" "$f"
      fi
    else
      # daemon-hosted background agent (or a record without a live client)
      entry=$(fetch_agents | jq -c --arg sid "$2" '[.[] | select(.sessionId == $sid)] | first // {}')
      # claude stop takes the short job id (first 8 chars of the session id)
      claude stop "${2:0:8}" >/dev/null 2>&1 &
      attach_title=$(jq -r '.name // empty' <<<"$entry")
      if [ -n "$f" ]; then
        jq --arg at "$attach_title" \
          '.status = "gone" | .owner = "client"
           | if $at != "" then .attach_title = $at else . end' \
          "$f" >"$f.tmp.$$" && mv "$f.tmp.$$" "$f"
      fi
    fi
    rm -f "$AGENTS_CACHE"
    ;;
  end)
    # ast end <session-id> — stop (if needed), drop from view, close its tab
    [ $# -ge 2 ] || { echo "usage: ast end <session-id>" >&2; exit 1; }
    f=$(ls "$STATE_DIR"/"$2"*.json 2>/dev/null | head -1 || true)
    cpid=""
    [ -n "$f" ] && cpid=$(jq -r '.pid // empty' "$f")
    # grab the tab handle from the LIVE process before killing it — the
    # recorded handle can be stale or missing, which left tabs open
    live_it=""
    if [ -n "$cpid" ] && kill -0 "$cpid" 2>/dev/null; then
      live_it=$(ps eww -o command= -p "$cpid" 2>/dev/null | tr ' ' '\n' \
        | grep -m1 '^ITERM_SESSION_ID=' | cut -d= -f2- || true)
    fi
    if [ -n "$cpid" ] && [ "$(jq -r '.owner // empty' "$f")" = "client" ] \
       && kill -0 "$cpid" 2>/dev/null; then
      kill -TERM "$cpid" 2>/dev/null || true
    else
      entry=$(fetch_agents | jq -c --arg sid "$2" '[.[] | select(.sessionId == $sid)] | first // {}')
      dpid=$(jq -r '.pid // empty' <<<"$entry")
      if [ "$(jq -r '.kind // empty' <<<"$entry")" = "interactive" ] && [ -n "$dpid" ]; then
        [ -z "$live_it" ] && live_it=$(ps eww -o command= -p "$dpid" 2>/dev/null | tr ' ' '\n' \
          | grep -m1 '^ITERM_SESSION_ID=' | cut -d= -f2- || true)
        kill -TERM "$dpid" 2>/dev/null || true
      else
        claude stop "${2:0:8}" >/dev/null 2>&1 &
      fi
    fi
    [ -n "$live_it" ] && close_iterm_by_id "$live_it" >/dev/null 2>&1 &
    # attach/resume client tabs aren't in the record (pool forks have no
    # terminal env) — find them by process and close their exact tabs
    for apid in $(pgrep -f "claude attach ${2:0:8}" 2>/dev/null; pgrep -f "claude --resume $2" 2>/dev/null); do
      aid=$(ps eww -o command= -p "$apid" 2>/dev/null | tr ' ' '\n' \
        | grep -m1 '^ITERM_SESSION_ID=' | cut -d= -f2- || true)
      kill -TERM "$apid" 2>/dev/null || true
      [ -n "$aid" ] && close_iterm_by_id "$aid" >/dev/null 2>&1 &
    done
    if [ -n "$f" ]; then
      it=$(jq -r '.terminal.iterm_session_id // empty' "$f")
      at=$(jq -r '.attach_title // empty' "$f")
      # tab close is cosmetic — run it in the background, id handle first
      if [ -n "$it" ]; then
        close_iterm_by_id "$it" >/dev/null 2>&1 &
      elif [ -n "$at" ]; then
        close_iterm_by_title "$at" >/dev/null 2>&1 &
      fi
      jq '.status = "ended"' "$f" >"$f.tmp.$$" && mv "$f.tmp.$$" "$f"
    fi
    # the daemon keeps completed jobs as "resumable" forever — drop the job
    # registry entry too, unless the session is still live. The transcript
    # stays in ~/.claude/projects, so archive search / --resume still work.
    jobdir="$HOME/.claude/jobs/${2:0:8}"
    if [ -d "$jobdir" ]; then
      sleep 0.5  # let a just-killed client die before the liveness check
      if ! claude agents --json 2>/dev/null \
           | jq -e --arg sid "$2" '.[] | select(.sessionId == $sid)' >/dev/null 2>&1; then
        rm -rf "$jobdir"
      fi
    fi
    rm -f "$AGENTS_CACHE"
    ;;
  tidy)
    # ast tidy [ai] [all] — auto-group sessions (Arc Tidy style).
    #   default: ungrouped only, by repo/folder from cwd
    #   ai:  semantic clusters via claude -p
    #   all: regroup everything — existing (manual) assignments overwritten
    MODE=""; ALL=""
    for a in "${@:2}"; do case "$a" in (ai) MODE=ai ;; (all) ALL=1 ;; esac; done
    list=$(cmd_sessions_json 2>/dev/null \
      | jq -c --arg all "$ALL" \
          '[.[] | select($all != "" or (.group // "") == "")
                | {sid: .session_id, title: (.title // ""), cwd: (.cwd // "")}]')
    cnt=$(jq 'length' <<<"$list")
    if [ "$cnt" = "0" ]; then echo "no ungrouped sessions"; exit 0; fi
    existing=$(cat "$GROUPS_FILE" 2>/dev/null || echo '{}')
    jq -e . >/dev/null 2>&1 <<<"$existing" || existing='{}'
    assigns='{}'
    if [ "$MODE" = "ai" ]; then
      gnames=$(jq -r '[.[]] | unique | join(", ")' <<<"$existing")
      items=$(jq -r '.[] | "\(.sid)\t\(.title)\t\(.cwd)"' <<<"$list")
      prompt="다음 AI 코딩 세션들을 주제별로 2~5개 그룹으로 묶어라. 그룹명은 짧은 한국어. 기존 그룹명(${gnames:-없음})이 어울리면 재사용. 오직 JSON 객체 하나만 출력: {\"<세션id>\": \"<그룹명>\", ...}. 다른 텍스트 금지.

세션 목록 (id, 제목, 경로):
$items"
      raw=$(CST_INTERNAL=1 claude -p --strict-mcp-config "$prompt" 2>/dev/null | sed 's/^```json//; s/^```//; s/```$//' | tr -d '\r' || true)
      if jq -e 'type == "object"' >/dev/null 2>&1 <<<"$raw"; then
        # reuse existing group names case-insensitively — the model tends to
        # invent "ADP" next to an existing "adp"
        assigns=$(jq -c --argjson ex "$existing" '
          ([$ex[]] | unique | map({key: ascii_downcase, value: .}) | from_entries) as $canon
          | with_entries(select((.value | type) == "string" and .value != ""))
          | with_entries(.value = ($canon[.value | ascii_downcase] // .value))' <<<"$raw")
      else
        echo "ai grouping failed — falling back to repo grouping" >&2
      fi
    fi
    if [ "$assigns" = "{}" ]; then
      # deterministic: repo name (first path segment after /GitHub/), else
      # the cwd basename
      assigns=$(jq -c 'map({key: .sid,
        value: (.cwd
          | if test("/GitHub/") then (split("/GitHub/")[1] | split("/")[0])
            elif . == "" then "기타"
            else (split("/") | map(select(. != "")) | last // "기타") end)})
        | from_entries' <<<"$list")
    fi
    jq -n --argjson a "$existing" --argjson b "$assigns" '$a + $b' >"$GROUPS_FILE.tmp.$$" \
      && mv "$GROUPS_FILE.tmp.$$" "$GROUPS_FILE"
    echo "grouped $(jq 'length' <<<"$assigns") sessions:"
    jq -r 'to_entries | group_by(.value) | .[] | "  \(.[0].value): \(length)"' <<<"$assigns"
    ;;
  icon)
    # ast icon <key|emoji|image-path> — set the menubar/search icon.
    #   keys: claude codex
    #   image: png/gif path (gif animates) · anything else: treated as emoji
    [ $# -ge 2 ] || { echo "usage: ast icon <key|emoji|image.png|image.gif>" >&2; exit 1; }
    APPID="com.dean.agents-session-tracker"
    ICON_DIR="${CST_STATE_DIR:-$HOME/.local/state/claude-session-tracker}"
    arg="$2"
    if [ -f "$arg" ]; then
      case "$arg" in
        (*.gif|*.GIF)
          cp "$arg" "$ICON_DIR/icon.gif" && rm -f "$ICON_DIR/icon.png" ;;
        (*)
          sips -s format png "$arg" --out "$ICON_DIR/icon.png" >/dev/null 2>&1 \
            || cp "$arg" "$ICON_DIR/icon.png"
          rm -f "$ICON_DIR/icon.gif" ;;
      esac
      defaults write "$APPID" menubarAgent custom
      echo "icon: custom image ($arg)"
    else
      case "$arg" in
        (claude|codex)
          defaults write "$APPID" menubarAgent "$arg"
          echo "icon: $arg" ;;
        (*)
          defaults write "$APPID" menubarEmoji "$arg"
          defaults write "$APPID" menubarAgent emoji
          echo "icon: emoji $arg" ;;
      esac
    fi
    # apply by restarting the app (one-shot — no polling in the app)
    pkill -f "MacOS/AgentsSessionTracker" 2>/dev/null || true
    sleep 0.4
    open "/Applications/Agents Session Tracker.app" 2>/dev/null || true
    ;;
  skills-json)
    # list available skills / slash commands as [{name, description}].
    # Built-in skills live inside the claude binary (no SKILL.md on disk),
    # so seed the well-known ones statically.
    out=$(jq -n '[
      {name: "simplify",       description: "변경 코드 단순화/정리 리뷰 후 적용"},
      {name: "code-review",    description: "변경분 버그 중심 코드 리뷰"},
      {name: "security-review", description: "브랜치 변경분 보안 리뷰"},
      {name: "init",           description: "CLAUDE.md 생성"},
      {name: "run",            description: "앱 실행해서 변경 확인"},
      {name: "loop",           description: "프롬프트/커맨드 주기 실행"},
      {name: "fork",           description: "현재 세션 포크 (백그라운드)"},
      {name: "compact",        description: "컨텍스트 압축"},
      {name: "usage",          description: "플랜 사용량 확인"},
      {name: "model",          description: "모델 변경 (예: /model opus)"},
      {name: "resume",         description: "세션 재개 픽커 — ⌘↩(터미널 입력)로 보내야 동작"}
    ]')
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      case "$f" in
        */commands/*.md) name=$(basename "$f" .md) ;;
        *) name=$(basename "$(dirname "$f")") ;;
      esac
      desc=$(grep -m1 '^description:' "$f" 2>/dev/null | sed 's/^description:[[:space:]]*//' | head -c 100 || true)
      out=$(jq --arg n "$name" --arg d "$desc" \
        'if any(.[]; .name == $n) then . else . + [{name: $n, description: $d}] end' <<<"$out")
    done < <(
      ls "$HOME"/.claude/skills/*/SKILL.md 2>/dev/null
      ls "$HOME"/.claude/commands/*.md 2>/dev/null
      find "$HOME/.claude/plugins/cache" -maxdepth 6 -name SKILL.md 2>/dev/null | head -60
    )
    jq 'sort_by(.name)' <<<"$out"
    ;;
  hub) focus_hub ;;
  agents-tab) focus_hub ;;
  focus-agent)
    # focus the terminal of an untracked interactive session: exact pid from
    # the daemon, cwd scan as fallback ($3=cwd)
    [ $# -ge 2 ] || { echo "usage: ast focus-agent <session-id> [cwd]" >&2; exit 1; }
    if resolve_by_session "$2" && jump_resolved; then exit 0; fi
    if [ -n "${3:-}" ] && resolve_live "$3" && jump_resolved; then exit 0; fi
    [ -n "${3:-}" ] && open_agents_tab "$3" >/dev/null 2>&1
    ;;
  clean) cmd_clean "${2:-}" ;;
  *) echo "usage: ast [list|jump <id>|copy-resume <id>|clean [hours]]" >&2; exit 1 ;;
esac
